# PostgreSQL Database Connection URL (Supports Neon, Supabase, AWS RDS, or Local Postgres)
DATABASE_URL=postgres://postgres:password@localhost:5432/investment_tracker

# Google Gemini API Key for Safeguarded AI Explanations
GEMINI_API_KEY=your_gemini_api_key_here

# NextAuth / Auth.js Secret
NEXTAUTH_SECRET=your_nextauth_secret_minimum_32_characters
NEXTAUTH_URL=http://localhost:3000

# Optional Bearer Token for AMFI Cron Background Job
CRON_SECRET=your_cron_secret_token
